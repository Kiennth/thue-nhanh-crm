# Copy file này thành .env.local rồi điền giá trị thật (lấy từ Supabase dashboard:
# Project Settings → API). KHÔNG commit .env.local (đã có trong .gitignore).

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role secret
# CHỈ dùng ở server (Server Actions), KHÔNG BAO GIỜ để lộ ra client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# URL gốc của app — dùng làm redirect target cho email mời/khôi phục mật khẩu.
# Đổi thành domain thật khi deploy production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
