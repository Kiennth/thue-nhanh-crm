# Copy file này thành .env.local rồi điền giá trị thật (lấy từ Supabase dashboard:
# Project Settings → API). KHÔNG commit .env.local (đã có trong .gitignore).

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role secret
# CHỈ dùng ở server (Server Actions), KHÔNG BAO GIỜ để lộ ra client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# URL gốc của app — dùng làm redirect target cho email mời/khôi phục mật khẩu,
# và để server tự gọi lại trang in chứng từ khi xuất PDF gửi email.
# Đổi thành domain thật khi deploy production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# resend.com → API Keys. Dùng để gửi chứng từ (hợp đồng/báo giá/biên bản) qua
# email thẳng cho khách. Domain gửi (RESEND_FROM_EMAIL) phải đã verify trong
# Resend trước, nếu không email sẽ bị từ chối hoặc vào spam.
RESEND_API_KEY=
RESEND_FROM_EMAIL="CTCP TMDV THUÊ NHANH <no-reply@thuenhanh.vn>"
