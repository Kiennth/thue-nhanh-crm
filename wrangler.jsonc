{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "custom-worker.js",
  "name": "thue-nhanh-crm",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  // Địa chỉ chính thức của CRM — zone thuenhanh.vn nằm trên Cloudflare,
  // custom domain tự lo DNS + SSL cho subdomain này khi deploy.
  "routes": [{ "pattern": "crm.thuenhanh.vn", "custom_domain": true }],
  // Giữ địa chỉ *.workers.dev chạy song song (mặc định bị tắt khi có custom
  // domain) — dự phòng lúc DNS trục trặc và để test không đụng domain chính.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Render PDF chứng từ (hợp đồng/báo giá/biên bản) qua trình duyệt headless
  // của Cloudflare — Puppeteer thường không chạy được trong Workers isolate,
  // binding này expose 1 trình duyệt thật ở phía Cloudflare cho @cloudflare/
  // puppeteer điều khiển từ xa. Xem src/lib/pdf.ts.
  "browser": { "binding": "BROWSER" },
  // Smart Placement (2026-10-03): Worker chạy gần Supabase thay vì gần người
  // dùng — mỗi trang gọi DB nhiều lượt nối đuôi, mỗi lượt từ edge HKG tới DB
  // mất ~450ms; đặt cạnh DB thì còn vài chục ms.
  "placement": { "mode": "smart" },
  // Email nhắc việc 17h (custom-worker.js → scheduled) — CEO 2026-10-04 chưa
  // muốn dùng ("rác, tao ở trên CRM suốt"): tắt lịch chạy. Bật lại thì đặt
  // "0 10 * * *" (10:00 UTC = 17h VN) + DAILY_REMINDERS_ENABLED=1.
  "triggers": { "crons": [] }
}
